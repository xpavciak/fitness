{
  "name": "@fitness/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo (React Native + TypeScript) app: onboarding, plan, workout logging, progress and settings. Local-first.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e:web": "node e2e/web-smoke.mts"
  },
  "dependencies": {
    "@expo/log-box": "~57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@fitness/engine": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.2",
    "jsdom": "^27.0.0",
    "playwright-core": "1.56.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
