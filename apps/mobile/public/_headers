# Cloudflare Pages response headers for the web export (D12).
# When Supabase sync (D4) or the coach proxy (D5) is wired, add their origins to connect-src.
# HSTS is left to Cloudflare's own setting (SSL/TLS -> Edge Certificates) so it doesn't force
# HTTPS on other subdomains of the user's domain.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex

# Bundles are content-hashed, so they can be cached forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
